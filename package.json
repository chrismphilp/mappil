{
  "name": "mappil",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/generate-sitemap.js && PUPPETEER_EXECUTABLE_PATH= react-snap",
    "test": "react-scripts test",
    "optimize:geojson": "node scripts/simplify-world-geojson.js",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "crawl": false,
    "include": [
      "/",
      "/world-map-quiz",
      "/africa-map-quiz",
      "/asia-map-quiz",
      "/europe-map-quiz",
      "/north-america-map-quiz",
      "/south-america-map-quiz",
      "/oceania-map-quiz"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.34.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.27.2",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.2",
    "react-scripts": "5.0.0",
    "react-snap": "^1.23.0",
    "typescript": "^4.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^16.11.25",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.2",
    "postcss": "^8.4.7",
    "tailwindcss": "^3.0.23",
    "yaml": "^2.8.3"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
